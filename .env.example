# Startup configuration files (relative to the project working directory).
XHS_LLM_CONFIG=examples/llm-config.json
XHS_EXECUTION_CONFIG=examples/execution-config.json
XHS_BROWSER_CHANNEL=chrome

# Search and image services: paste your own keys after the equals sign.
TAVILY_API_KEY=
XHS_IMAGE_API_KEY=

# Optional text-model keys. api_key_env in each JSON role names its variable.
# A direct api_key in JSON or a saved Web credential takes precedence.
DEEPSEEK_API_KEY=
XHS_SUPERVISOR_API_KEY=
XHS_LLM_API_KEY=
XHS_RESEARCH_API_KEY=
XHS_CREATION_API_KEY=
XHS_REVIEW_API_KEY=
